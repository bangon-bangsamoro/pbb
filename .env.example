# ============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# ----------------------------------------------------------------------------
# Set with:  supabase secrets set KEY=value
# Never commit real values. CI fails the build if a .env file appears in the
# repository or if a service-role key is found outside supabase/functions/.
# ============================================================================

# --- Injected automatically by Supabase; listed here for completeness -------
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY

# --- Shared ----------------------------------------------------------------
# Salt for the SHA-256 of client IPs used by every rate limiter. Rotating it
# resets all rate-limit windows, so rotate deliberately, not on a schedule.
IP_HASH_SALT=

# --- Turnstile (submit-lead) -----------------------------------------------
TURNSTILE_SECRET_KEY=

# --- Semaphore SMS ---------------------------------------------------------
# One account key covers submit-lead confirmations and card-claim OTPs.
# The OTP route (/api/v4/otp) costs 2 credits per message rather than 1: it is
# carried on a path dedicated to OTP traffic that keeps delivering when the
# telcos are congested. For a code a member is waiting on, that is worth the
# second credit.
SEMAPHORE_API_KEY=
# Must be a Sender Name already approved on the Semaphore account, or every
# send is rejected. Defaults to "PBB" in code.
SEMAPHORE_SENDER_NAME=PBB

# --- Card claim (request-card-otp, issue-id-card) ---------------------------
# Server-side pepper mixed into the SHA-256 of every one-time code, so that a
# database-only compromise still cannot verify a guessed code offline. Use at
# least 32 random bytes.
#
#   openssl rand -hex 32
#
# ROTATING THIS INVALIDATES EVERY OUTSTANDING CODE. That is a five-minute
# window, so rotation is cheap — but do it between SMS sends, not during a
# chapter registration drive.
OTP_PEPPER=
